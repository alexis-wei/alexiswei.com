# /baking — baking log

# Turso (logs, ingredients). Leave unset locally to use a SQLite file in .baking-local/
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Cloudflare R2 (photos, videos, ingredient images). Leave unset locally to store files in .baking-local/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, ideally a custom domain, e.g. https://media.alexiswei.com
R2_PUBLIC_URL=

# Editing passcode, plus a long random string used to sign the editor cookie
# (generate one with: openssl rand -base64 32)
BAKING_PASSCODE=
BAKING_SESSION_SECRET=
